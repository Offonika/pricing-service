SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Moscow

# Bitrix Disk "Входящие" -> pricing-service normalization -> Bitrix Disk "Готово/Ошибки".
