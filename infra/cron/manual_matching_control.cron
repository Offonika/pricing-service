SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Moscow

# Daily read-only control of procurement manual competitor matching; no Bitrix side effects.
5 19 * * 1-5 root /opt/MM/pricing-service/infra/cron/manual_matching_control.sh >> /var/log/pricing/manual_matching_control.cron.log 2>&1
