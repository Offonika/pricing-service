// Вставить этот файл в модуль основной формы внешней обработки.
//
// Реквизиты формы:
// - ДатаНачала
// - ДатаОкончания
// - НаименованиеСтатьиДДС
// - ФайлЛога
// - ТолькоПроверка
// - ПерепроводитьПроведенные
// - МаксимумДокументов
//
// Кнопки:
// - ВыбратьФайлЛогаНажатие
// - ВыполнитьНажатие

Процедура ПриОткрытии()

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоМесяца(ТекущаяДата());
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(НаименованиеСтатьиДДС)) Тогда
		НаименованиеСтатьиДДС = "Оплата от покупателя (за товар)";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТолькоПроверка) Тогда
		ТолькоПроверка = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПерепроводитьПроведенные) Тогда
		ПерепроводитьПроведенные = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(МаксимумДокументов) Тогда
		МаксимумДокументов = 0;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ФайлЛога)) Тогда
		ФайлЛога = КаталогВременныхФайлов()
			+ "bank_acquiring_dds_postfill_"
			+ Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss")
			+ ".csv";
	КонецЕсли;

КонецПроцедуры

Процедура ВыбратьФайлЛогаНажатие(Кнопка)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Куда записать лог дозаполнения";
	Диалог.Фильтр = "CSV (*.csv)|*.csv|Все файлы (*.*)|*.*";
	Диалог.ПроверятьСуществованиеФайла = Ложь;
	Диалог.ПолноеИмяФайла = ФайлЛога;

	Если Диалог.Выбрать() Тогда
		ФайлЛога = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьНажатие(Кнопка)

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Или НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Предупреждение("Укажите период.");
		Возврат;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		Предупреждение("Дата начала больше даты окончания.");
		Возврат;
	КонецЕсли;

	Если НЕ ТолькоПроверка Тогда
		Ответ = Вопрос(
			"Будут изменены входящие платежные поручения эквайринга за период и, при необходимости, перепроведены. Продолжить?",
			РежимДиалогаВопрос.ДаНет);

		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Итог = ЭтотОбъект.ДозаполнитьСтатьюДДСЭквайринга(
			ДатаНачала,
			ДатаОкончания,
			НаименованиеСтатьиДДС,
			ФайлЛога,
			ТолькоПроверка,
			ПерепроводитьПроведенные,
			МаксимумДокументов);

		Сообщить(
			"Готово. Всего: " + Строка(Итог.Всего)
			+ ", к исправлению: " + Строка(Итог.КИсправлению)
			+ ", исправлено: " + Строка(Итог.Исправлено)
			+ ", уже заполнено: " + Строка(Итог.УжеЗаполнено)
			+ ", пропущено: " + Строка(Итог.Пропущено)
			+ ", ошибок: " + Строка(Итог.Ошибок)
			+ ". Лог: " + Итог.ФайлЛога);
	Исключение
		Предупреждение("Ошибка выполнения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры
