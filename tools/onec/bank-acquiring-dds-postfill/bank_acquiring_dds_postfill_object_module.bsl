// Внешняя обработка: дозаполнение статьи ДДС для эквайринговых входящих платежек.
// Вставить этот файл в модуль объекта внешней обработки.

Функция ДозаполнитьСтатьюДДСЭквайринга(
	ДатаНачала,
	ДатаОкончания,
	НаименованиеСтатьиДДС = "Оплата от покупателя (за товар)",
	ФайлЛога = "",
	ТолькоПроверка = Истина,
	ПерепроводитьПроведенные = Истина,
	МаксимумДокументов = 0) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ВызватьИсключение "Не указана дата начала.";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ВызватьИсключение "Не указана дата окончания.";
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(НаименованиеСтатьиДДС)) Тогда
		НаименованиеСтатьиДДС = "Оплата от покупателя (за товар)";
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ФайлЛога)) Тогда
		ФайлЛога = КаталогВременныхФайлов()
			+ "bank_acquiring_dds_postfill_"
			+ Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss")
			+ ".csv";
	КонецЕсли;

	СтатьяДДС = НайтиСтатьюДДСПоНаименованиюMM(НаименованиеСтатьиДДС);
	Если Не ЗначениеЗаполнено(СтатьяДДС) Тогда
		ВызватьИсключение "Не найдена статья ДДС: " + НаименованиеСтатьиДДС;
	КонецЕсли;

	Результат = Новый Структура("Всего,КИсправлению,Исправлено,УжеЗаполнено,Пропущено,Ошибок,ФайлЛога", 0, 0, 0, 0, 0, 0, ФайлЛога);

	Лог = Новый ТекстовыйДокумент;
	Лог.ДобавитьСтроку("Статус;Ссылка;Номер;Дата;ПроведенДо;СтрокРасшифровки;СтатьяДо;СтатьяПосле;Комментарий");

	Выборка = НайтиДокументыЭквайринга(ДатаНачала, ДатаОкончания);

	Пока Выборка.Следующий() Цикл

		Если МаксимумДокументов > 0 И Результат.Всего >= МаксимумДокументов Тогда
			Прервать;
		КонецЕсли;

		Результат.Всего = Результат.Всего + 1;

		Попытка
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();

			Если ДокументОбъект.ПометкаУдаления Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				ДобавитьСтрокуЛога(Лог, "SKIP_DELETED", ДокументОбъект, 0, "", "", "Документ помечен на удаление.");
				Продолжить;
			КонецЕсли;

			КоличествоСтрок = ДокументОбъект.РасшифровкаПлатежа.Количество();
			Если КоличествоСтрок = 0 Тогда
				Результат.Ошибок = Результат.Ошибок + 1;
				ДобавитьСтрокуЛога(Лог, "ERROR_NO_ROWS", ДокументОбъект, 0, "", "", "В документе нет строк расшифровки платежа.");
				Продолжить;
			КонецЕсли;

			СтатьяДо = ПолучитьПредставлениеСтатейДДС(ДокументОбъект);
			ВсеСтрокиУжеЗаполнены = Истина;

			Для Каждого СтрокаРасшифровки Из ДокументОбъект.РасшифровкаПлатежа Цикл
				Если СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств <> СтатьяДДС Тогда
					ВсеСтрокиУжеЗаполнены = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если ВсеСтрокиУжеЗаполнены Тогда
				Результат.УжеЗаполнено = Результат.УжеЗаполнено + 1;
				ДобавитьСтрокуЛога(Лог, "ALREADY_OK", ДокументОбъект, КоличествоСтрок, СтатьяДо, Строка(СтатьяДДС), "Статья уже заполнена.");
				Продолжить;
			КонецЕсли;

			Результат.КИсправлению = Результат.КИсправлению + 1;

			Для Каждого СтрокаРасшифровки Из ДокументОбъект.РасшифровкаПлатежа Цикл
				СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
			КонецЦикла;

			Если ТолькоПроверка Тогда
				ДобавитьСтрокуЛога(Лог, "DRY_RUN", ДокументОбъект, КоличествоСтрок, СтатьяДо, Строка(СтатьяДДС), "Проверка без записи.");
				Продолжить;
			КонецЕсли;

			Если ДокументОбъект.Проведен Тогда
				Если ПерепроводитьПроведенные Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					Результат.Пропущено = Результат.Пропущено + 1;
					ДобавитьСтрокуЛога(Лог, "SKIP_POSTED", ДокументОбъект, КоличествоСтрок, СтатьяДо, Строка(СтатьяДДС), "Документ проведен, перепроведение выключено.");
					Продолжить;
				КонецЕсли;
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;

			Результат.Исправлено = Результат.Исправлено + 1;
			ДобавитьСтрокуЛога(Лог, "OK", ДокументОбъект, КоличествоСтрок, СтатьяДо, Строка(СтатьяДДС), "Статья ДДС дозаполнена.");

		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			ДобавитьСтрокуЛогаПоСсылке(Лог, "ERROR", Выборка.Ссылка, ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Лог.Записать(ФайлЛога, КодировкаТекста.UTF8);

	Возврат Результат;

КонецФункции

Функция НайтиДокументыЭквайринга(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	ПлатежноеПоручениеВходящее.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.ВидОперации = &ВидОперации
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеВходящее.Дата,
	|	ПлатежноеПоручениеВходящее.Номер";

	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ПоступлениеОплатыПоПлатежнымКартам);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция НайтиСтатьюДДСПоНаименованиюMM(НаименованиеСтатьи)

	СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(НаименованиеСтатьи, Истина);
	Если ЗначениеЗаполнено(СтатьяДДС) Тогда
		Возврат СтатьяДДС;
	КонецЕсли;

	СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(НаименованиеСтатьи, Ложь);
	Если ЗначениеЗаполнено(СтатьяДДС) Тогда
		Возврат СтатьяДДС;
	КонецЕсли;

	Если НаименованиеСтатьи = "Оплата от покупателя (за товар)" Тогда
		ВыборкаСтатейДДС = Справочники.СтатьиДвиженияДенежныхСредств.Выбрать();
		Пока ВыборкаСтатейДДС.Следующий() Цикл
			Если ВыборкаСтатейДДС.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;

			НаименованиеВерх = ВРег(ВыборкаСтатейДДС.Наименование);
			Если Найти(НаименованиеВерх, "ОПЛАТА") > 0
				И Найти(НаименованиеВерх, "ПОКУПАТЕЛ") > 0 Тогда

				СтатьяДДС = ВыборкаСтатейДДС.Ссылка;
				Если Найти(НаименованиеВерх, "ТОВАР") > 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтатьяДДС;

КонецФункции

Функция ПолучитьПредставлениеСтатейДДС(ДокументОбъект)

	Результат = "";

	Для Каждого СтрокаРасшифровки Из ДокументОбъект.РасшифровкаПлатежа Цикл
		ПредставлениеСтатьи = Строка(СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств);
		Если ПустаяСтрока(ПредставлениеСтатьи) Тогда
			ПредставлениеСтатьи = "<пусто>";
		КонецЕсли;

		Если Найти(";" + Результат + ";", ";" + ПредставлениеСтатьи + ";") = 0 Тогда
			Если НЕ ПустаяСтрока(Результат) Тогда
				Результат = Результат + ", ";
			КонецЕсли;
			Результат = Результат + ПредставлениеСтатьи;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьСтрокуЛога(Лог, Статус, ДокументОбъект, КоличествоСтрок, СтатьяДо, СтатьяПосле, Комментарий)

	Лог.ДобавитьСтроку(
		CSV(Статус) + ";"
		+ CSV(Строка(ДокументОбъект.Ссылка)) + ";"
		+ CSV(ДокументОбъект.Номер) + ";"
		+ CSV(Формат(ДокументОбъект.Дата, "ДФ=yyyy-MM-dd")) + ";"
		+ CSV(Строка(ДокументОбъект.Проведен)) + ";"
		+ CSV(Строка(КоличествоСтрок)) + ";"
		+ CSV(СтатьяДо) + ";"
		+ CSV(СтатьяПосле) + ";"
		+ CSV(Комментарий));

КонецПроцедуры

Процедура ДобавитьСтрокуЛогаПоСсылке(Лог, Статус, СсылкаДокумента, Комментарий)

	Лог.ДобавитьСтроку(
		CSV(Статус) + ";"
		+ CSV(Строка(СсылкаДокумента)) + ";;;;;;;"
		+ CSV(Комментарий));

КонецПроцедуры

Функция CSV(Значение)

	СтрокаЗначения = Строка(Значение);
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, """", """""");
	Возврат """" + СтрокаЗначения + """";

КонецФункции
