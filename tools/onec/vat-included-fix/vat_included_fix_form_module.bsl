// Вставить этот файл в модуль основной формы внешней обработки.
//
// Реквизиты формы:
// - ФайлСписка                  Строка
// - ФайлЛога                    Строка
// - ТолькоПроверка              Булево
// - ПерепроводитьПроведенные    Булево
// - КонтролироватьСумму         Булево
// - ДопустимоеОтклонение        Число
// - МаксимумДокументов          Число
// - ОбрабатыватьНепроведенные   Булево
//
// Кнопки формы:
// - ВыбратьФайлСпискаНажатие
// - ВыбратьФайлЛогаНажатие
// - ВыполнитьНажатие

Процедура ПриОткрытии()

	Если НЕ ЗначениеЗаполнено(ТолькоПроверка) Тогда
		ТолькоПроверка = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПерепроводитьПроведенные) Тогда
		ПерепроводитьПроведенные = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КонтролироватьСумму) Тогда
		КонтролироватьСумму = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДопустимоеОтклонение) Тогда
		ДопустимоеОтклонение = 0.05;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(МаксимумДокументов) Тогда
		МаксимумДокументов = 0;
	КонецЕсли;

	Если ПустаяСтрока(ФайлЛога) Тогда
		ФайлЛога = КаталогВременныхФайлов()
			+ "vat_included_fix_log_"
			+ Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss")
			+ ".csv";
	КонецЕсли;

КонецПроцедуры

Процедура ВыбратьФайлСпискаНажатие(Кнопка)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите vat_top_sales_TO_FIX.xlsx или CSV";
	Диалог.Фильтр = "Excel/CSV (*.xlsx;*.csv)|*.xlsx;*.csv|Все файлы (*.*)|*.*";
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.ПолноеИмяФайла = ФайлСписка;

	Если Диалог.Выбрать() Тогда
		ФайлСписка = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

Процедура ВыбратьФайлЛогаНажатие(Кнопка)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Куда записать лог исправления";
	Диалог.Фильтр = "CSV (*.csv)|*.csv|Все файлы (*.*)|*.*";
	Диалог.ПроверятьСуществованиеФайла = Ложь;
	Диалог.ПолноеИмяФайла = ФайлЛога;

	Если Диалог.Выбрать() Тогда
		ФайлЛога = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьНажатие(Кнопка)

	Если ПустаяСтрока(ФайлСписка) Тогда
		Предупреждение("Укажите файл списка.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ФайлЛога) Тогда
		Предупреждение("Укажите файл лога.");
		Возврат;
	КонецЕсли;

	Если НЕ ТолькоПроверка Тогда
		Ответ = Вопрос(
			"Будет выполнено изменение документов РеализацияТоваровУслуг и перепроведение проведенных документов. Продолжить?",
			РежимДиалогаВопрос.ДаНет);

		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Итог = ЭтотОбъект.ВыполнитьИсправлениеНДСВТомЧисле(
			ФайлСписка,
			ФайлЛога,
			ТолькоПроверка,
			ПерепроводитьПроведенные,
			КонтролироватьСумму,
			ДопустимоеОтклонение,
			МаксимумДокументов,
			ОбрабатыватьНепроведенные);

		Сообщить(
			"Готово. Всего: " + Итог.Всего
			+ ", к исправлению: " + Итог.КИсправлению
			+ ", исправлено: " + Итог.Исправлено
			+ ", уже исправлено: " + Итог.УжеИсправлено
			+ ", пропущено: " + Итог.Пропущено
			+ ", ошибок: " + Итог.Ошибок
			+ ". Лог: " + ФайлЛога);
	Исключение
		Предупреждение("Ошибка выполнения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры
