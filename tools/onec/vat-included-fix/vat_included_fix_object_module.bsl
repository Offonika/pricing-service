// Внешняя обработка: исправление РТУ из списка vat_top_sales_TO_FIX.csv/xlsx.
// Назначение: перевести документы РеализацияТоваровУслуг из "НДС сверху"
// в "НДС в том числе" с уменьшением суммы документа на ошибочный НДС сверху.
//
// Вставить этот файл в модуль объекта внешней обработки.

Перем мФайлЛогаИсправленияНДС;

Функция ВыполнитьИсправлениеНДСВТомЧисле(
	ФайлСписка,
	ФайлЛога,
	ТолькоПроверка = Истина,
	ПерепроводитьПроведенные = Истина,
	КонтролироватьСумму = Истина,
	ДопустимоеОтклонение = 0.05,
	МаксимумДокументов = 0,
	ОбрабатыватьНепроведенные = Ложь) Экспорт

	Результат = Новый Структура(
		"Всего,КИсправлению,Исправлено,УжеИсправлено,Пропущено,Ошибок",
		0, 0, 0, 0, 0, 0);

	Если ПустаяСтрока(СокрЛП(ФайлСписка)) Тогда
		ВызватьИсключение "Не указан файл списка.";
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ФайлЛога)) Тогда
		ФайлЛога = КаталогВременныхФайлов() + "vat_included_fix_log.csv";
	КонецЕсли;
	мФайлЛогаИсправленияНДС = ФайлЛога;

	ДокументыИзФайла = ПрочитатьСписокДокументов(ФайлСписка);
	Если ДокументыИзФайла.Количество() = 0 Тогда
		ВызватьИсключение "В файле списка не найдено документов для обработки.";
	КонецЕсли;

	Лог = Новый ТекстовыйДокумент;
	Лог.ДобавитьСтроку("Статус;Номер;ДатаФайла;Ссылка;СуммаФайла;СуммаДо;СуммаПосле;Комментарий");

	Для Каждого СтрокаФайла Из ДокументыИзФайла Цикл

		Если МаксимумДокументов > 0 И Результат.Всего >= МаксимумДокументов Тогда
			Прервать;
		КонецЕсли;

		Результат.Всего = Результат.Всего + 1;

		Если ВРег(СтрокаФайла.ФлагНДСВключен4946) <> "0X00" Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			ДобавитьСтрокуЛога(Лог, "SKIP_FILE_FLAG", СтрокаФайла, "", "", "", "",
				"В файле признак _Fld4946 не равен 0x00.");
			Продолжить;
		КонецЕсли;

		Если ВРег(СтрокаФайла.Флаг4945) <> "0X01" Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			ДобавитьСтрокуЛога(Лог, "SKIP_FILE_NO_VAT_ACCOUNTING", СтрокаФайла, "", "", "", "",
				"В файле признак учета НДС _Fld4945 не равен 0x01.");
			Продолжить;
		КонецЕсли;

		Если СтрокаФайла.НДСВсегоСверху <= 0 Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			ДобавитьСтрокуЛога(Лог, "SKIP_NO_VAT", СтрокаФайла, "", "", "", "",
				"В файле нет суммы НДС сверху.");
			Продолжить;
		КонецЕсли;

		РезультатПоиска = НайтиРеализациюПоСтрокеФайла(СтрокаФайла, ДопустимоеОтклонение);

		Если РезультатПоиска.Статус = "НеНайден" Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
			ДобавитьСтрокуЛога(Лог, "ERROR_NOT_FOUND", СтрокаФайла, "", "", "", "",
				"Документ не найден по номеру и дате.");
			Продолжить;
		КонецЕсли;

		Если РезультатПоиска.Статус = "Много" Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
			ДобавитьСтрокуЛога(Лог, "ERROR_NOT_UNIQUE", СтрокаФайла, "", "", "", "",
				"Найдено несколько документов с таким номером и датой.");
			Продолжить;
		КонецЕсли;

		ДанныеДокумента = РезультатПоиска.Данные;

		Если ДанныеДокумента.ПометкаУдаления Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			ДобавитьСтрокуЛога(Лог, "SKIP_DELETED", СтрокаФайла, ДанныеДокумента.Ссылка, "",
				ДанныеДокумента.СуммаДокумента, "", "Документ помечен на удаление.");
			Продолжить;
		КонецЕсли;

		Если Не ДанныеДокумента.Проведен И Не ОбрабатыватьНепроведенные Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			ДобавитьСтрокуЛога(Лог, "SKIP_NOT_POSTED", СтрокаФайла, ДанныеДокумента.Ссылка, "",
				ДанныеДокумента.СуммаДокумента, "", "Документ не проведен.");
			Продолжить;
		КонецЕсли;

		Если КонтролироватьСумму Тогда
			ОтклонениеСуммы = МодульЧисла(ДанныеДокумента.СуммаДокумента - СтрокаФайла.СуммаДокумента);
			Если ОтклонениеСуммы > ДопустимоеОтклонение Тогда
				Результат.Ошибок = Результат.Ошибок + 1;
				ДобавитьСтрокуЛога(Лог, "ERROR_SUM_MISMATCH", СтрокаФайла, ДанныеДокумента.Ссылка, "",
					ДанныеДокумента.СуммаДокумента, "", "Сумма документа отличается от суммы в файле.");
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если ДанныеДокумента.СуммаВключаетНДС Тогда
			Результат.УжеИсправлено = Результат.УжеИсправлено + 1;
			ДобавитьСтрокуЛога(Лог, "ALREADY_OK", СтрокаФайла, ДанныеДокумента.Ссылка, "",
				ДанныеДокумента.СуммаДокумента, ДанныеДокумента.СуммаДокумента,
				"Документ уже с признаком НДС в том числе.");
			Продолжить;
		КонецЕсли;

		Если Не ДанныеДокумента.УчитыватьНДС Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
			ДобавитьСтрокуЛога(Лог, "ERROR_NO_VAT_ACCOUNTING", СтрокаФайла, ДанныеДокумента.Ссылка, "",
				ДанныеДокумента.СуммаДокумента, "", "В документе отключен учет НДС.");
			Продолжить;
		КонецЕсли;

			Попытка
				ДокументОбъект = ДанныеДокумента.Ссылка.ПолучитьОбъект();
				СуммаДо = ДокументОбъект.СуммаДокумента;
				ОжидаемаяСуммаПосле = Окр(СтрокаФайла.СуммаДокумента - СтрокаФайла.НДСВсегоСверху, 2);

				СуммаПослеКонвертации = КонвертироватьДокументВНДСВТомЧисле(ДокументОбъект);

				Если КонтролироватьСумму Тогда
					ОтклонениеПосле = МодульЧисла(СуммаПослеКонвертации - ОжидаемаяСуммаПосле);
					Если ОтклонениеПосле > ДопустимоеОтклонение Тогда
						Результат.Ошибок = Результат.Ошибок + 1;
						ДобавитьСтрокуЛога(Лог, "ERROR_AFTER_SUM_MISMATCH", СтрокаФайла, ДанныеДокумента.Ссылка, "",
							СуммаДо, СуммаПослеКонвертации, "После конвертации сумма не равна ожидаемой сумме без НДС сверху: "
							+ ОжидаемаяСуммаПосле + ".");
						Продолжить;
					КонецЕсли;
				КонецЕсли;

			Результат.КИсправлению = Результат.КИсправлению + 1;

			Если ТолькоПроверка Тогда
				ДобавитьСтрокуЛога(Лог, "DRY_RUN", СтрокаФайла, ДанныеДокумента.Ссылка, "",
					СуммаДо, СуммаПослеКонвертации,
					"Конвертация проверена в памяти, запись документа не выполнялась.");
				Продолжить;
			КонецЕсли;

			Если ДанныеДокумента.Проведен Тогда
				Если ПерепроводитьПроведенные Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Иначе
					Результат.Пропущено = Результат.Пропущено + 1;
					ДобавитьСтрокуЛога(Лог, "SKIP_REPOST_DISABLED", СтрокаФайла, ДанныеДокумента.Ссылка, "",
						СуммаДо, СуммаПослеКонвертации, "Документ проведен, перепроведение выключено.");
					Продолжить;
				КонецЕсли;
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;

				Результат.Исправлено = Результат.Исправлено + 1;
				ДобавитьСтрокуЛога(Лог, "OK", СтрокаФайла, ДанныеДокумента.Ссылка, ДокументОбъект.Ссылка,
					СуммаДо, ДокументОбъект.СуммаДокумента, "Исправлен признак НДС, сумма документа уменьшена на НДС сверху.");

			Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			СтатусОшибки = ?(ТолькоПроверка, "ERROR_DRY_RUN", "ERROR_WRITE");
			ДобавитьСтрокуЛога(Лог, СтатусОшибки, СтрокаФайла, ДанныеДокумента.Ссылка, "",
				ДанныеДокумента.СуммаДокумента, "", ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	ЗаписатьЛог(Лог, ФайлЛога);

	Возврат Результат;

КонецФункции

Функция ПрочитатьСписокДокументов(ФайлСписка)

	ФайлНаДиске = Новый Файл(ФайлСписка);
	Если Не ФайлНаДиске.Существует() Тогда
		ВызватьИсключение "Файл списка не найден: " + ФайлСписка;
	КонецЕсли;

	Таблица = СоздатьТаблицуСпискаДокументов();
	Ключи = Новый Соответствие;

	ИмяФайлаНРег = НРег(ФайлСписка);
	Если Прав(ИмяФайлаНРег, 4) = ".csv" Тогда
		ПрочитатьСписокДокументовCSV(ФайлСписка, Таблица, Ключи);
	Иначе
		ПрочитатьСписокДокументовТабличныйДокумент(ФайлСписка, Таблица, Ключи);
	КонецЕсли;

	Возврат Таблица;

КонецФункции

Функция СоздатьТаблицуСпискаДокументов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СсылкаДокументаHex");
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("ДатаДокумента");
	Таблица.Колонки.Добавить("ДатаСтрокой");
	Таблица.Колонки.Добавить("Флаг4945");
	Таблица.Колонки.Добавить("ФлагНДСВключен4946");
	Таблица.Колонки.Добавить("СуммаДокумента");
	Таблица.Колонки.Добавить("НДСВсегоСверху");

	Возврат Таблица;

КонецФункции

Процедура ПрочитатьСписокДокументовCSV(ФайлСписка, Таблица, Ключи)

	Текст = Новый ТекстовыйДокумент;
	Попытка
		Текст.Прочитать(ФайлСписка, КодировкаТекста.UTF8);
	Исключение
		Текст.Прочитать(ФайлСписка);
	КонецПопытки;

	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл

		СтрокаТекста = СокрЛП(Текст.ПолучитьСтроку(НомерСтроки));
		Если ПустаяСтрока(СтрокаТекста) Тогда
			Продолжить;
		КонецЕсли;

		Поля = ПолучитьПервыеПоляCSV(СтрокаТекста, 11);
		ДобавитьСтрокуСпискаДокументов(Поля, Таблица, Ключи);

	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьСписокДокументовТабличныйДокумент(ФайлСписка, Таблица, Ключи)

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ФайлСписка);

	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл

		Поля = Новый Массив;
		Для НомерКолонки = 1 По 11 Цикл
			Поля.Добавить(СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст));
		КонецЦикла;

		ДобавитьСтрокуСпискаДокументов(Поля, Таблица, Ключи);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуСпискаДокументов(Поля, Таблица, Ключи)

	Если Поля.Количество() < 11 Тогда
		Возврат;
	КонецЕсли;

	Если Найти(ВРег(Поля[0]), "ССЫЛКАДОКУМЕНТА") > 0 Тогда
		Возврат;
	КонецЕсли;

	ДатаДокумента = ПолучитьДатуИзSQLСтроки(Поля[2]);
	СуммаДокумента = ПолучитьЧислоИзСтроки(Поля[5]);
	НДСВсегоСверху = ПолучитьЧислоИзСтроки(Поля[10]);

	Если ДатаДокумента = Неопределено Или СуммаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключ = Поля[1] + "|" + Формат(НачалоДня(ДатаДокумента), "ДФ=yyyyMMdd");
	Если Ключи[Ключ] <> Неопределено Тогда
		// Повтор в файле не дублируем: один документ исправляется один раз.
		Возврат;
	КонецЕсли;
	Ключи.Вставить(Ключ, Истина);

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.СсылкаДокументаHex = Поля[0];
	НоваяСтрока.Номер = Поля[1];
	НоваяСтрока.ДатаДокумента = ДатаДокумента;
	НоваяСтрока.ДатаСтрокой = Поля[2];
	НоваяСтрока.Флаг4945 = Поля[3];
	НоваяСтрока.ФлагНДСВключен4946 = Поля[4];
	НоваяСтрока.СуммаДокумента = СуммаДокумента;
	НоваяСтрока.НДСВсегоСверху = ?(НДСВсегоСверху = Неопределено, 0, НДСВсегоСверху);

КонецПроцедуры

Функция НайтиРеализациюПоСтрокеФайла(СтрокаФайла, ДопустимоеОтклонение)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Реализация.Ссылка,
	|	Реализация.Проведен,
	|	Реализация.ПометкаУдаления,
	|	Реализация.СуммаДокумента,
	|	Реализация.УчитыватьНДС,
	|	Реализация.СуммаВключаетНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Номер = &Номер
	|	И Реализация.Дата >= &ДатаНачала
	|	И Реализация.Дата <= &ДатаКонца";

	Запрос.УстановитьПараметр("Номер", СтрокаФайла.Номер);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(СтрокаФайла.ДатаДокумента));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(СтрокаФайла.ДатаДокумента));

	Результат = Запрос.Выполнить().Выгрузить();

	Если Результат.Количество() = 0 Тогда
		Возврат Новый Структура("Статус,Данные", "НеНайден", Неопределено);
	КонецЕсли;

	КоличествоПоСсылке = 0;
	ДанныеПоСсылке = Неопределено;
	Для Каждого СтрокаРезультата Из Результат Цикл
		Если СсылкаДокументаСоответствуетHex(СтрокаРезультата.Ссылка, СтрокаФайла.СсылкаДокументаHex) Тогда
			КоличествоПоСсылке = КоличествоПоСсылке + 1;
			ДанныеПоСсылке = СтрокаРезультата;
		КонецЕсли;
	КонецЦикла;

		Если КоличествоПоСсылке = 1 Тогда
			Возврат Новый Структура("Статус,Данные", "ОК", ДанныеПоСсылке);
		ИначеЕсли КоличествоПоСсылке > 1 Тогда
			Возврат Новый Структура("Статус,Данные", "Много", Неопределено);
		ИначеЕсли Результат.Количество() = 1 Тогда
			Возврат Новый Структура("Статус,Данные", "ОК", Результат.Получить(0));
		КонецЕсли;

	КоличествоПоСумме = 0;
	ДанныеПоСумме = Неопределено;
	Для Каждого СтрокаРезультата Из Результат Цикл
		Если МодульЧисла(СтрокаРезультата.СуммаДокумента - СтрокаФайла.СуммаДокумента) <= ДопустимоеОтклонение Тогда
			КоличествоПоСумме = КоличествоПоСумме + 1;
			ДанныеПоСумме = СтрокаРезультата;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоПоСумме = 1 Тогда
		Возврат Новый Структура("Статус,Данные", "ОК", ДанныеПоСумме);
	Иначе
		Возврат Новый Структура("Статус,Данные", "Много", Неопределено);
	КонецЕсли;

КонецФункции

Функция КонвертироватьДокументВНДСВТомЧисле(ДокументОбъект)

	Если ДокументОбъект.СуммаВключаетНДС Тогда
		Возврат ДокументОбъект.СуммаДокумента;
	КонецЕсли;

	ДокументОбъект.СуммаВключаетНДС = Истина;

	ПересчитатьНДСТабличнойЧасти(ДокументОбъект, "Товары");
	ПересчитатьНДСТабличнойЧасти(ДокументОбъект, "Услуги");

	ДокументОбъект.СуммаДокумента =
		УчетНДС.ПолучитьСуммуДокументаСНДС(ДокументОбъект, "Товары")
		+ УчетНДС.ПолучитьСуммуДокументаСНДС(ДокументОбъект, "Услуги");

	Возврат ДокументОбъект.СуммаДокумента;

КонецФункции

Процедура ПересчитатьНДСТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти)

	МетаданныеДокумента = ДокументОбъект.Метаданные();
	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("Сумма", МетаданныеДокумента, ИмяТабличнойЧасти)
		Или Не ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СуммаНДС", МетаданныеДокумента, ИмяТабличнойЧасти)
		Или Не ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СтавкаНДС", МетаданныеДокумента, ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, ДокументОбъект);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПервыеПоляCSV(СтрокаТекста, КоличествоПолей)

	Поля = Новый Массив;
	ТекущееПоле = "";
	ВКавычках = Ложь;
	Позиция = 1;

	Пока Позиция <= СтрДлина(СтрокаТекста) Цикл

		Символ = Сред(СтрокаТекста, Позиция, 1);

		Если Символ = """" Тогда
			Если ВКавычках
				И Позиция < СтрДлина(СтрокаТекста)
				И Сред(СтрокаТекста, Позиция + 1, 1) = """" Тогда
				ТекущееПоле = ТекущееПоле + """";
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВКавычках = Не ВКавычках;
		ИначеЕсли Символ = ";" И Не ВКавычках Тогда
			Поля.Добавить(СокрЛП(ТекущееПоле));
			Если Поля.Количество() >= КоличествоПолей Тогда
				Возврат Поля;
			КонецЕсли;
			ТекущееПоле = "";
		Иначе
			ТекущееПоле = ТекущееПоле + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Поля.Добавить(СокрЛП(ТекущееПоле));

	Возврат Поля;

КонецФункции

Функция ПолучитьДатуИзSQLСтроки(СтрокаДаты)

	СтрокаДаты = СокрЛП(СтрокаДаты);

	Если СтрДлина(СтрокаДаты) < 10 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если Сред(СтрокаДаты, 5, 1) = "-" Тогда
			Год = Число(Сред(СтрокаДаты, 1, 4));
			Месяц = Число(Сред(СтрокаДаты, 6, 2));
			День = Число(Сред(СтрокаДаты, 9, 2));
		ИначеЕсли Сред(СтрокаДаты, 3, 1) = "." Тогда
			День = Число(Сред(СтрокаДаты, 1, 2));
			Месяц = Число(Сред(СтрокаДаты, 4, 2));
			Год = Число(Сред(СтрокаДаты, 7, 4));
		Иначе
			Возврат Неопределено;
		КонецЕсли;

		Час = 0;
		Минута = 0;
		Секунда = 0;

		Если СтрДлина(СтрокаДаты) >= 19 Тогда
			Если Сред(СтрокаДаты, 5, 1) = "-" Тогда
				Час = Число(Сред(СтрокаДаты, 12, 2));
				Минута = Число(Сред(СтрокаДаты, 15, 2));
				Секунда = Число(Сред(СтрокаДаты, 18, 2));
			ИначеЕсли Сред(СтрокаДаты, 3, 1) = "." Тогда
				Час = Число(Сред(СтрокаДаты, 12, 2));
				Минута = Число(Сред(СтрокаДаты, 15, 2));
				Секунда = Число(Сред(СтрокаДаты, 18, 2));
			КонецЕсли;
		КонецЕсли;

		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПолучитьЧислоИзСтроки(Значение)

	Буфер = СокрЛП(Строка(Значение));
	Буфер = СтрЗаменить(Буфер, " ", "");
	Буфер = СтрЗаменить(Буфер, ".", ",");

	Если ПустаяСтрока(Буфер) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Буфер);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция МодульЧисла(Значение)

	Если Значение < 0 Тогда
		Возврат -Значение;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция СсылкаДокументаСоответствуетHex(Ссылка, СсылкаДокументаHex)

	НормализованныйHex = НормализоватьHexСсылки(СсылкаДокументаHex);
	Если ПустаяСтрока(НормализованныйHex) Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрДлина(НормализованныйHex) <> 32 Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ИдентификаторСсылки = НРег(СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()), "-", ""));
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат ИдентификаторСсылки = НормализованныйHex
		Или ИдентификаторСсылки = HexSQLServerGuidВСтроку1С(НормализованныйHex);

КонецФункции

Функция НормализоватьHexСсылки(Значение)

	Буфер = НРег(СокрЛП(Строка(Значение)));
	Буфер = СтрЗаменить(Буфер, "0x", "");
	Буфер = СтрЗаменить(Буфер, "-", "");
	Буфер = СтрЗаменить(Буфер, " ", "");
	Буфер = СтрЗаменить(Буфер, Символы.Таб, "");

	Возврат Буфер;

КонецФункции

Функция HexSQLServerGuidВСтроку1С(Hex)

	// SQL Server хранит первые 3 группы uniqueidentifier в обратном порядке байтов.
	Возврат Сред(Hex, 7, 2) + Сред(Hex, 5, 2) + Сред(Hex, 3, 2) + Сред(Hex, 1, 2)
		+ Сред(Hex, 11, 2) + Сред(Hex, 9, 2)
		+ Сред(Hex, 15, 2) + Сред(Hex, 13, 2)
		+ Сред(Hex, 17);

КонецФункции

Процедура ДобавитьСтрокуЛога(Лог, Статус, СтрокаФайла, Ссылка, СсылкаПосле, СуммаДо, СуммаПосле, Комментарий)

	СсылкаДляЛога = Ссылка;
	Если ЗначениеЗаполнено(СсылкаПосле) Тогда
		СсылкаДляЛога = СсылкаПосле;
	КонецЕсли;

	Лог.ДобавитьСтроку(
		ПодготовитьПолеЛога(Статус) + ";"
		+ ПодготовитьПолеЛога(СтрокаФайла.Номер) + ";"
		+ ПодготовитьПолеЛога(СтрокаФайла.ДатаСтрокой) + ";"
		+ ПодготовитьПолеЛога(СсылкаДляЛога) + ";"
		+ ПодготовитьПолеЛога(СтрокаФайла.СуммаДокумента) + ";"
		+ ПодготовитьПолеЛога(СуммаДо) + ";"
		+ ПодготовитьПолеЛога(СуммаПосле) + ";"
		+ ПодготовитьПолеЛога(Комментарий));

	Если Не ПустаяСтрока(СокрЛП(мФайлЛогаИсправленияНДС)) Тогда
		ЗаписатьЛог(Лог, мФайлЛогаИсправленияНДС);
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьПолеЛога(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Поле = Строка(Значение);
	Поле = СтрЗаменить(Поле, ";", ",");
	Поле = СтрЗаменить(Поле, Символы.ПС, " ");
	Поле = СтрЗаменить(Поле, Символы.ВК, " ");
	Поле = СтрЗаменить(Поле, Символы.ПФ, " ");

	Возврат СокрЛП(Поле);

КонецФункции

Процедура ЗаписатьЛог(Лог, ФайлЛога)

	Попытка
		Лог.Записать(ФайлЛога, КодировкаТекста.UTF8);
	Исключение
		Лог.Записать(ФайлЛога);
	КонецПопытки;

КонецПроцедуры
